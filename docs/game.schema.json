{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aikids.games/game.schema.json",
  "title": "Ai Kids Games manifest (games/<slug>/game.json)",
  "description": "The single source of truth for a game's listing. The website's registry, the README game table, llms.txt and the structured data are generated from it with `npm run manifests`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "title",
    "tagline",
    "shortDescription",
    "longDescription",
    "version",
    "minAge",
    "ageRange",
    "genres",
    "tags",
    "keywords",
    "features",
    "contentNotes",
    "controls",
    "devices",
    "orientation",
    "playTime",
    "storage",
    "capture",
    "license",
    "source",
    "site"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "description": "Folder name under games/ and the URL slug on aikids.games."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "One short line, shown in the hero and on cards."
    },
    "shortDescription": {
      "type": "string",
      "minLength": 20,
      "maxLength": 260,
      "description": "Two short sentences for the details page, search results and structured data."
    },
    "longDescription": {
      "type": "string",
      "minLength": 40,
      "description": "A paragraph for the README and llms.txt."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "The released version; the monorepo tag is <slug>-v<version>."
    },
    "minAge": {
      "type": "integer",
      "minimum": 3,
      "maximum": 17
    },
    "ageRange": {
      "type": "string",
      "pattern": "^\\d+(\\+|–\\d+)$",
      "description": "Shown as \"Ages <ageRange>\": either \"8+\" or \"10–14\" (en dash)."
    },
    "genres": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Action",
          "Adventure",
          "Casual",
          "Cozy",
          "Farming",
          "Learning",
          "Puzzle",
          "Racing",
          "Strategy"
        ]
      }
    },
    "tags": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 24
      },
      "description": "Short words players can search for on the site."
    },
    "keywords": {
      "type": "array",
      "minItems": 4,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9 +&'-]*$"
      },
      "description": "Genre, feature and audience words for search engines. Never another company's game title or trademark."
    },
    "features": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 6
      }
    },
    "contentNotes": {
      "type": "string",
      "minLength": 20,
      "description": "What parents should know: conflict, scariness, reading, saves."
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "types",
        "quickStart",
        "howToPlay"
      ],
      "properties": {
        "types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Keyboard",
              "Mouse",
              "Gamepad",
              "Touch"
            ]
          }
        },
        "quickStart": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 6
          }
        },
        "howToPlay": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 6
          }
        }
      }
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Computer",
          "Tablet",
          "Phone"
        ]
      }
    },
    "orientation": {
      "enum": [
        "any",
        "landscape",
        "portrait"
      ],
      "description": "How phones and tablets must be held. The game shows its own prompt; the site never adds one."
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Browser features the game needs, e.g. \"WebGL 2\"."
    },
    "playTime": {
      "type": "string",
      "minLength": 3
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefix",
        "keys"
      ],
      "properties": {
        "prefix": {
          "type": "string",
          "minLength": 3,
          "description": "Every localStorage key the game writes starts with this (see apps/site/STORAGE_AUDIT.md)."
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Every persistent key; <slot> or <track> marks a placeholder."
        },
        "probe": {
          "type": "string",
          "description": "The short-lived availability-check key, written and removed at once."
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "script"
      ],
      "properties": {
        "route": {
          "type": "string",
          "description": "The URL query the preview capture starts from."
        },
        "script": {
          "type": "string",
          "description": "The capture script that records the previews (monorepo-relative)."
        }
      }
    },
    "license": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "pattern": "^games/[a-z0-9-]+$"
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "featured",
        "releaseDate",
        "accentColor",
        "coverLayers",
        "status"
      ],
      "properties": {
        "featured": {
          "type": "boolean"
        },
        "releaseDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "coverLayers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "float",
              "bob",
              "twinkle",
              "drift"
            ]
          }
        },
        "status": {
          "enum": [
            "Ready to play",
            "Coming soon",
            "In development"
          ],
          "description": "\"In development\" games are validated but stay off the website, the README and llms.txt."
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "description": "Position in the website's lists and featured rotation (lower first)."
        }
      }
    }
  }
}
