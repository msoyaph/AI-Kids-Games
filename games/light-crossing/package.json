{
  "name": "light-crossing",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Light Crossing \u2014 a cozy procedural island life-sim for the browser",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm run e2e",
    "pacing": "tsx scripts/pacing.ts",
    "analyze-playtests": "tsx scripts/analyze-playtests.ts",
    "bench": "tsx scripts/bench.ts",
    "readability": "tsx scripts/readability.ts",
    "size": "tsx scripts/check-size.ts",
    "e2e:low": "E2E_LOW=1 playwright test --project=desktop",
    "e2e:touch": "playwright test --project=chromium-* --project=webkit-*",
    "e2e:layout": "playwright test --project=layout-chromium --project=layout-webkit",
    "e2e:ci": "playwright test --project=desktop --project=chromium-phone-portrait --project=webkit-phone-landscape --project=layout-chromium --grep-invert \"Chapter 1\"",
    "touch-audit": "tsx scripts/touch-audit.ts"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.5"
  }
}
