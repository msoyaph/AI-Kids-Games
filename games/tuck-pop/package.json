{
  "name": "tuck-pop",
  "private": true,
  "version": "1.0.0",
  "description": "Tuck Pop, a kid-friendly block puzzle for Ai Kids Games.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sim": "tsx scripts/simulate.ts",
    "shots": "tsx scripts/shots.ts",
    "levels": "tsx scripts/levels.ts",
    "perf": "tsx scripts/perf.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  }
}
