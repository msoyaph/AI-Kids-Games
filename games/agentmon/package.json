{
  "name": "agentmon",
  "private": true,
  "version": "1.1.0",
  "description": "Agentmon, a creature-befriending pixel adventure for Ai Kids Games.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit tests/sim",
    "test:sim": "vitest run tests/sim",
    "test:all": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
