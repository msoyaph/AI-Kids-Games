{
  "name": "calex-cart",
  "version": "0.2.0",
  "private": true,
  "description": "Calex Cart — an original 3D kart racer for ages 10–14. Single-file browser build.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/checkSize.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "sim": "tsx scripts/simulate.ts",
    "analyze-playtests": "tsx scripts/analyzePlaytests.ts",
    "calibrate-staff": "tsx scripts/calibrateStaff.ts",
    "bench": "node scripts/bench.mjs",
    "size": "node scripts/checkSize.mjs",
    "validate": "tsx scripts/validateTracks.ts",
    "test:e2e:ci": "playwright test",
    "balance-report": "tsx scripts/balanceReport.ts",
    "bench-controls": "node scripts/benchControls.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
