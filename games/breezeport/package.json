{
  "name": "breezeport",
  "private": true,
  "version": "0.1.0",
  "description": "Breezeport, a game for AI Kids Games.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-build.mjs",
    "preview": "vite preview",
