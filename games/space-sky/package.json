{
  "name": "space-sky",
  "private": true,
  "version": "1.0.0",
  "description": "Space Sky - a space exploration adventure game for kids aged 6-10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-size.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run build && vitest run && playwright test",
    "pacing": "vite-node scripts/pacing-sim.ts",
    "svgs": "vite-node scripts/export-site-svgs.ts",
    "perf": "node scripts/perf.mjs",
    "shots": "node scripts/shots.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "0.186.0",
    "postprocessing": "6.39.5",
    "three": "0.186.1",
    "typescript": "~7.0",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.5"
  }
}
