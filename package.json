{
  "name": "ai-kids-games",
  "private": true,
  "description": "Free, open-source browser games for kids, and the AI Kids Games website that hosts them.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "games/*",
    "templates/*",
    "tooling/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/site",
    "build": "npm run build --workspace apps/site",
    "test": "npm test --workspace apps/site",
    "test:e2e": "npm run test:e2e --workspace apps/site",
    "import-game": "tsx scripts/import-game.ts",
    "check": "tsx scripts/check-repo.ts && tsx scripts/check-builds.ts",
    "check:repo": "tsx scripts/check-repo.ts",
    "check:builds": "tsx scripts/check-builds.ts",
    "typecheck": "tsc -p tsconfig.json",
    "manifests": "tsx scripts/manifests.ts",
    "audit-storage": "tsx scripts/audit-storage.ts",
    "new-game": "tsx scripts/new-game.ts",
    "new-community-game": "tsx scripts/new-community-game.ts",
    "dev:community": "tsx scripts/dev-community.ts",
    "check-submission": "tsx scripts/check-submission.ts",
    "review-submission": "tsx scripts/review-submission.ts",
    "release:local": "tsx scripts/release-local.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
