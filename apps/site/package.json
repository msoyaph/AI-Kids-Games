{
  "name": "@ai-kids-games/site",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/generate-community.ts && vite --host 127.0.0.1 --port 5190",
    "build": "tsx scripts/check-deployment.ts && tsx scripts/validate-games.ts && tsx scripts/generate-community.ts && tsc --noEmit && vite build && tsx scripts/generate-route-shells.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4190",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "capture-previews": "tsx scripts/capture-previews.ts",
    "serve": "tsx scripts/serve-dist.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "indexnow": "tsx scripts/indexnow.ts",
    "page-weight": "tsx scripts/page-weight.ts",
    "review-screens": "tsx scripts/review-screens.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/nunito": "^5.2.7",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "ffmpeg-static": "^5.3.0",
    "opentype.js": "^1.3.4",
    "schema-dts": "2.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
